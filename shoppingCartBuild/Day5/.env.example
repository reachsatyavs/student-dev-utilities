# Flask
SECRET_KEY=dev-secret-change-me
FLASK_DEBUG=True

# SQLite database file (created automatically, lives in this folder)
DB_FILE=shopping_cart.db

# Admin account seeded by init_db.py
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123

# Products API (Session 3)
PRODUCTS_API_URL=https://dummyjson.com/products

# Flask-Mail (Session 5 - OTP password reset). With Gmail, use an "App Password",
# not your normal login password: https://myaccount.google.com/apppasswords
# Leave MAIL_USERNAME blank to just print the OTP to the console instead.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Rate limiting (Session 5)
RATELIMIT_STORAGE_URI=memory://
